    # --- Right Column: Scientists ---
    axs[ii, 1].barh(y, male_s, color=colours[1], alpha=0.9, height=0.7)
    axs[ii, 1].barh(y, female_s, left=male_s, color=colours[0], alpha=0.9, height=0.7)
    
