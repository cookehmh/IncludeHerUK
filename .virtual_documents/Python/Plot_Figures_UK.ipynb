def wrap_label(label, max_words=2):
    words = label.split()
    lines = []
    for i in range(0, len(words), max_words):
        lines.append(" ".join(words[i:i+max_words]))
    return "\n".join(lines)

region_labels = [
    f"{wrap_label(r)}\n({v/total*100:.1f}%)" for r, v in zip(regions, vals)
]


